# ConDash Proxy Server Configuration

# API key for authenticating requests (leave empty to disable auth)
# Clients pass this as ?key=<value> — same format as corsproxy.io
CONDASH_API_KEY=your-secret-key-here

# Rate limit (requests per minute per IP)
RATE_LIMIT=120/minute

# Upstream request timeout in seconds
REQUEST_TIMEOUT=30

# Allow requests to private/internal IP addresses (e.g. for self-hosted services on a LAN)
# Set to "true" to disable SSRF protection. Only enable this on a trusted private network.
ALLOW_PRIVATE_IP=false

# Server port
PORT=5000

# Your GHCR image name (e.g. your-username/even-condash)
# Used by docker-compose when pulling the image
GITHUB_REPO=your-username/even-condash

GHCR_USER=your-username
GHCR_PAT=your-personal-access-token